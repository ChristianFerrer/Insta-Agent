# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321  # Comma-separated Telegram user IDs allowed to use the bot

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# fal.ai (Flux image generation)
FAL_KEY=your_fal_key_here

# Instagram Graph API
IG_ACCESS_TOKEN=your_long_lived_token
IG_BUSINESS_ACCOUNT_ID=17841...

# Database
DATABASE_PATH=./data/insta_agent.db

# Scheduler
PROACTIVE_HOUR=10
PROACTIVE_TIMEZONE=America/Argentina/Buenos_Aires

# App
LOG_LEVEL=INFO
