# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=                 # random string, used as secret token header
TELEGRAM_ALLOWED_USER_IDS=               # comma-separated, e.g. "123456789,987654321"

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# fal.ai
FAL_KEY=

# Supabase
SUPABASE_URL=                            # https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=               # service role key (server-side only)
SUPABASE_STORAGE_BUCKET=bandtoons        # storage bucket for archived images

# Instagram Graph API (optional — leave empty to disable publishing)
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# Vercel
VERCEL_URL=                              # auto-injected by Vercel, no need to set manually
CRON_SECRET=                             # random string, must match Authorization header sent by cron
